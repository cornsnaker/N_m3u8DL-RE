# Telegram credentials (required) - get from https://my.telegram.org
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=your_api_hash_here
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Access control (optional, comma-separated Telegram user IDs).
# Leave empty to allow all users.
ALLOWED_USER_IDS=

# N_m3u8DL-RE binary path (defaults to searching PATH).
N_M3U8DL_BIN=N_m3u8DL-RE

# FFmpeg binary path (defaults to searching PATH).
FFMPEG_BIN=ffmpeg

# Working directory for downloads and session data.
WORK_DIR=./downloads

# Max concurrent download tasks.
MAX_CONCURRENT_TASKS=3

# Telegram progress message update interval (seconds).
PROGRESS_INTERVAL=5

# Max file size to upload to Telegram (MB). Telegram limit is ~2000 MB.
MAX_UPLOAD_SIZE_MB=2000
