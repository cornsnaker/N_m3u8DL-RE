# Telegram API credentials (https://my.telegram.org/apps)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_TOKEN=

# Restrict access to specific Telegram user IDs (comma-separated).
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Working directory for downloads and temp files.
WORK_DIR=./downloads

# Path to the N_m3u8DL-RE binary.
N_M3U8DL_RE_BIN=N_m3u8DL-RE

# Path to ffmpeg binary.
FFMPEG_BIN=ffmpeg

# Path to mp4decrypt binary (Bento4).
MP4DECRYPT_BIN=mp4decrypt

# Path to mkvmerge binary (MKVToolNix).
MKVMERGE_BIN=mkvmerge

# Path to Shaka Packager binary.
SHAKA_PACKAGER_BIN=packager

# Download thread count.
THREAD_COUNT=16

# Max concurrent download tasks.
MAX_CONCURRENT_TASKS=3

# Progress update interval (seconds).
PROGRESS_INTERVAL=5

# Max file size for Telegram upload (bytes). Default 2 GB.
UPLOAD_SPLIT_SIZE=2000000000
